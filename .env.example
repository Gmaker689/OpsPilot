# ==========================================
# OpsPilot Docker 环境变量（全部配置入口）
# ==========================================

# ---------- LLM API Keys ----------
DS_THINK_CHAT_MODEL_API_KEY=sk-your-key
DS_THINK_CHAT_MODEL_BASE_URL=https://api.siliconflow.cn/v1
DS_THINK_CHAT_MODEL_MODEL=Qwen/Qwen3.6-27B

DS_QUICK_CHAT_MODEL_API_KEY=sk-your-key
DS_QUICK_CHAT_MODEL_BASE_URL=https://api.siliconflow.cn/v1
DS_QUICK_CHAT_MODEL_MODEL=Qwen/Qwen3.6-27B

DOUBAO_EMBEDDING_MODEL_API_KEY=sk-your-key
DOUBAO_EMBEDDING_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DOUBAO_EMBEDDING_MODEL_MODEL=text-embedding-v4

# ---------- Prometheus ----------
PROMETHEUS_URL=http://127.0.0.1:9090

# ---------- MCP Server — 阿里云 SLS ----------
ALIBABA_ACCESS_KEY_ID=your_access_key_id
ALIBABA_ACCESS_KEY_SECRET=your_access_key_secret
SLS_ENDPOINT=cn-hangzhou.log.aliyuncs.com
SLS_PROJECT=your_project
SLS_LOGSTORE=your_logstore

# ---------- 前端端口（可选，默认 8098）----------
# FRONTEND_PORT=8098
